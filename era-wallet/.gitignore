# Reproducible Phase 6B binding staging output (installed bindings live in lib/)
artifacts/phase6b/generated/

# Local validation logs (results are summarized in tracked documentation)
evidence/phase6b-final-validation/

# Local production release payloads; tracked manifests live under release/.
/production-release/
/era-wallet-phase6b-production-release.zip
/era-wallet-phase6b-production-release.zip.sha256

# Website handoff binaries remain local; metadata, checksums, and evidence are tracked.
/release/website-handoff/**/public/**/*.zip
